# Nuxt 4 合并工程环境变量示例，复制为 .env 后按需填写

# MySQL（对齐原 server）
# 注意：本地开发不填时默认 root1234（与 nuxt.config 默认值一致）；生产环境必须填写强密码，缺失会启动报错
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yuindex
DB_USER=root
DB_PASSWORD=

# nuxt-auth-utils 会话加密密钥（生产必填，至少 32 位随机字符串）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=

# 百度翻译（可选，fanyi 命令需要）
BAIDU_FANYI_APPID=
BAIDU_FANYI_KEY=

# SMTP 邮件（可选，找回密码需要）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 部署在可信反向代理之后时设为 true（限流取真实 IP）
TRUST_PROXY=false
