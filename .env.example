# Nuxt 4 合并工程环境变量示例，复制为 .env 后按需填写

# MySQL
# 本地开发不填 DB_PASSWORD 时用不到这里（nuxt.config 里的开发默认值仅供 localhost/root）；
# 生产环境必须显式提供 DB_HOST 与强口令，缺失会启动即报错。
# 服务端取值优先级：NUXT_DB_* > 裸名 DB_* > 构建期默认值，两种写法都生效。
# 本文件会进版本库，只写占位符——真实地址/账号放在 .env（已被 .gitignore 忽略）。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webCommand
DB_USER=appuser
DB_PASSWORD=

*** nuxt-auth-utils 会话加密密钥（生产必填，至少 32 位随机字符串）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=

# SMTP 邮件（可选，找回密码需要）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 部署在可信反向代理之后时设为 true（限流取真实 IP）
TRUST_PROXY=false

# 站点绝对地址（SEO 必需：canonical / og:url / og:image 等绝对 URL 标签）
# 示例：https://command.zhangzhengyang.com（注意：不要以 / 结尾）
NUXT_PUBLIC_SITE_URL=https://command.zhangzhengyang.com
